{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/Pinterest/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/Pinterest/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/Pinterest",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "boards": {
      "type": "application",
      "root": "apps/boards",
      "entryFile": "main",
      "sourceRoot": "apps/boards/src",
      "compilerOptions": {
        "tsConfigPath": "apps/boards/tsconfig.app.json"
      }
    },
    "comments": {
      "type": "application",
      "root": "apps/comments",
      "entryFile": "main",
      "sourceRoot": "apps/comments/src",
      "compilerOptions": {
        "tsConfigPath": "apps/comments/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "likes": {
      "type": "application",
      "root": "apps/likes",
      "entryFile": "main",
      "sourceRoot": "apps/likes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/likes/tsconfig.app.json"
      }
    },
    "notifications": {
      "type": "application",
      "root": "apps/notifications",
      "entryFile": "main",
      "sourceRoot": "apps/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications/tsconfig.app.json"
      }
    },
    "pins": {
      "type": "application",
      "root": "apps/pins",
      "entryFile": "main",
      "sourceRoot": "apps/pins/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pins/tsconfig.app.json"
      }
    },
    "saves": {
      "type": "application",
      "root": "apps/saves",
      "entryFile": "main",
      "sourceRoot": "apps/saves/src",
      "compilerOptions": {
        "tsConfigPath": "apps/saves/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    }
  }
}